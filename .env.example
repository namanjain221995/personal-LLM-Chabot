# TechSara Local AI Analysis Platform — environment template
# Copy to .env and fill in the real values yourself. NEVER commit .env.

# Hugging Face token (recommended: speeds up / authorizes the gpt-oss-120b download)
HF_TOKEN=

# AWS credentials — used ONLY to read the Salesforce secret from AWS Secrets Manager
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Name of the AWS Secrets Manager secret containing the Salesforce JWT credentials
# (JSON keys: SF_CLIENT_ID, SF_USERNAME, SF_LOGIN_URL, PRIVATE_KEY_B64)
SF_SECRET_NAME=

# ALTERNATIVE: set the Salesforce JWT credentials directly and skip AWS
# Secrets Manager entirely (all four must be set; AWS_* can then stay blank).
#SF_CLIENT_ID=
#SF_USERNAME=
#SF_LOGIN_URL=
#SF_PRIVATE_KEY_B64=

# ── Model context (Phase 6) ──────────────────────────────────────────────────
# The REAL model window — MUST match the vLLM `--max-model-len` the main model
# serves. This is the app's honest view of the limit, not a knob that widens it.
# The main model's real window. Each request is actually sized against the
# window the SERVING model reports (vLLM /tokenize), so this is only the
# fallback used when that endpoint cannot be reached.
# Qwen3.6-35B-A3B is natively 262144 and has only TWO KV heads, so the full
# window costs ~10 GB of KV cache with --kv-cache-dtype fp8.
MODEL_MAX_CONTEXT=262144
# Ceiling on a completion when the calling engine does not request its own.
# Engines that need more (PDF/search answers) ask for it explicitly and are
# clamped to whatever actually fits — capping this low would bring back the
# empty answers the thinking model produces when it runs out of budget.
MODEL_MAX_OUTPUT=8192
# Headroom left free in every request (chat-template drift, sampling slack).
CONTEXT_SAFETY_MARGIN=512
# Timeout for the token-count probe; on timeout a character estimate is used.
TOKENIZE_TIMEOUT=5.0
# Classification calls only need the opening of a message to pick a route.
ROUTER_INPUT_CHAR_CAP=6000
# The embedding model has the smallest window in the stack (4096 tokens).
EMBED_INPUT_CHAR_CAP=8000

# ── OCR (2026-08-06) ─────────────────────────────────────────────────────────
# baidu/Unlimited-OCR on its own vLLM service: uploaded images and rendered
# PDF pages are transcribed first, and the transcript rides with the pixels
# to the main model. Runs fully local. Disabled/unreachable → pixels-only.
OCR_ENABLED=true
OCR_BASE_URL=http://vllm-ocr:30004/v1
OCR_MODEL=baidu/Unlimited-OCR

# ── Web search (Phase 1) ─────────────────────────────────────────────────────
# NOTE: enabling search sends queries to the web — the "nothing leaves this
# machine" guarantee no longer holds for search-enabled messages.
SEARCH_ENABLED=false
SEARCH_PROVIDER=searxng          # searxng | tavily | brave
SEARXNG_URL=http://searxng:8080  # self-hosted; the compose service below
SEARXNG_SECRET=                   # random string; required to start SearXNG
TAVILY_API_KEY=                  # only if SEARCH_PROVIDER=tavily
BRAVE_API_KEY=                   # only if SEARCH_PROVIDER=brave
SEARCH_MAX_RESULTS=100
FETCH_TIMEOUT_MS=8000
FETCH_MAX_BYTES=5000000

# ── Charts ───────────────────────────────────────────────────────────────────
# When a chart appears. Anything unrecognised falls back to `explicit`.
#   explicit  a chart only when you ask for one ("chart", "graph", "plot",
#             "show this visually", "bar chart", "funnel", "histogram"…).
#             This is the default and the historical behaviour.
#   hybrid    the above, plus four deterministic high-confidence shapes that
#             chart themselves: a time series, a single-metric category
#             comparison, a trusted Salesforce stage funnel, and a small
#             non-negative part-to-whole. Everything else stays text + table.
# There is no `automatic` mode.
CHART_TRIGGER_MODE=explicit

# A funnel asserts an ORDER, so one is only ever drawn when every stage in
# the result belongs to a trusted list. Salesforce's standard Opportunity,
# Lead and Case picklists are built in. If your org uses a custom sales
# process, name it here and it is trusted the same way; stages outside any
# trusted list fall back to a ranked horizontal bar rather than a funnel
# with a guessed sequence. JSON, one or more named orders:
#   CHART_FUNNEL_STAGE_ORDER={"sales":["Discovery","Pilot","Signed"]}
CHART_FUNNEL_STAGE_ORDER=

# ── URL / website analysis (Phase 2) ─────────────────────────────────────────
# Fetches links a user pastes (leaves the machine, user-initiated).
URL_ANALYSIS_ENABLED=true
URL_MAX_PAGES=5

# ── GitHub repository analysis (Phase 3) ─────────────────────────────────────
# Public repos only; shallow clone, capped, code NEVER executed.
REPO_ANALYSIS_ENABLED=true
REPO_MAX_MB=300
REPO_MAX_FILES=20000
WORKSPACE_TTL_HOURS=24
WORKSPACE_QUOTA_GB=20

# --- Context management (Phase A/B/C) -------------------------------------
# Thresholds are fractions of the USABLE budget (window − this request's
# output reservation − CONTEXT_SAFETY_MARGIN), not of the raw window.
CONTEXT_WARN_THRESHOLD=0.60
# Background: compact right AFTER a turn, so the user never waits for it.
CONTEXT_BG_COMPACT_THRESHOLD=0.70
# Synchronous: the hard guarantee, applied BEFORE a request goes out.
CONTEXT_COMPACT_THRESHOLD=0.80
# Turns kept verbatim; everything older folds into the rolling summary.
KEEP_RECENT_TURNS=8
SUMMARY_MAX_TOKENS=2000
# A thinking model given less than this returns an EMPTY answer, so input is
# trimmed further rather than letting the output reservation drop below it.
MIN_OUTPUT_FLOOR=1024
# Semantic recall over compacted turns (reuses Qwen3-Embedding-0.6B on :8003).
SEMANTIC_RECALL_ENABLED=true
RETRIEVE_TOP_K=6
# Context meter in the composer.
CONTEXT_METER_ENABLED=true

# --- Model serving ----------------------------------------------------------
# ONE model serves every chat path (Smart, Fast, routing, vision, agent).
# "Smart" vs "Fast" is not two models: it is the same weights with the
# reasoning pass on or off (enable_thinking), which is where the latency is.
# Host directory holding locally-downloaded weights, mounted read-only at
# /models inside the vLLM containers.
VLLM_MODELS_DIR=/home/techsphere/Documents/projects/vllm_models
