# TechSara user configuration
#
# Copy this file to .env and supply only values you own. Never commit .env,
# private keys, tokens, or backup copies.
#
# The launcher writes selected models, runtime URLs, container paths, context
# limits, capability flags, bind address, and generated local secrets to
# .runtime/generated.env and .runtime/secrets.env. Do not duplicate those
# launcher-managed values here.

# Optional Hugging Face token for gated/private model downloads. The launcher
# tries anonymously first and retries once with this token. An explicitly
# exported HF_TOKEN takes precedence over the value in this file.
HF_TOKEN=

# ---------------------------------------------------------------------------
# Salesforce (optional)
# ---------------------------------------------------------------------------
# Sync starts when SF_CLIENT_ID, SF_USERNAME, SF_LOGIN_URL and ONE assertion
# method are complete. Without them, the local UI still starts.

SF_CLIENT_ID=
SF_USERNAME=
SF_LOGIN_URL=
SF_API_VERSION=v61.0
SF_LIGHTNING_BASE_URL=https://your-org.lightning.force.com
SF_LIVE_ENABLED=true

# Simplest assertion method: the connected app's Consumer Secret.
SF_CLIENT_SECRET=

# JWT alternatives (use ONE, not both):
# - Host file: launcher reads a bounded PEM file and stages it as base64 in the
#   mode-0600 runtime secret file; the host path is never mounted into Docker.
# - Base64: encode the PEM yourself and place the value here.
#SF_PRIVATE_KEY_HOST_FILE=/absolute/path/to/salesforce-jwt-private-key.pem
#SF_PRIVATE_KEY_B64=

# ---------------------------------------------------------------------------
# Local application secrets (optional)
# ---------------------------------------------------------------------------
# Leave these blank to let the launcher create/reuse strong local values in
# .runtime/secrets.env. POSTGRES_DB/USER are non-secret and may be customized
# before the first database initialization.

POSTGRES_DB=techsara
POSTGRES_USER=techsara
POSTGRES_PASSWORD=
SESSION_SECRET=
PGADMIN_DEFAULT_EMAIL=admin@yourcompany.com
PGADMIN_DEFAULT_PASSWORD=
SEARXNG_SECRET=

# PostgreSQL application pool (per orchestrator process).
#APP_DB_POOL_MIN=2
#APP_DB_POOL_MAX=16
#APP_DB_POOL_TIMEOUT=10
#APP_DB_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Authentication (all optional; read by the orchestrator)
# ---------------------------------------------------------------------------
# The application has a real login: opaque server-side sessions in an HttpOnly
# cookie, workspaces, and role-based access. Create the first administrator
# with
#
#   ./techsara auth bootstrap --email you@example.com
#
# (the password is prompted over the terminal, or read from an exported
# AUTH_BOOTSTRAP_PASSWORD for unattended use — never passed on a command
# line). Everyone else joins by invitation, created in the web UI under
# /admin by an administrator. The defaults below apply when a key is unset.
#
# Session lifetimes: a "stay signed in" session rolls forward with activity up
# to AUTH_SESSION_DAYS of idleness and dies unconditionally
# AUTH_SESSION_ABSOLUTE_DAYS after it was created; unticked, the rolling
# window shrinks to AUTH_SESSION_UNREMEMBERED_HOURS.
#AUTH_SESSION_DAYS=30
#AUTH_SESSION_ABSOLUTE_DAYS=90
#AUTH_SESSION_UNREMEMBERED_HOURS=24
# Cookie Secure flag: auto (Secure exactly when the request arrived over
# https, so plain-http localhost development still gets a cookie), true, or
# false.
#AUTH_COOKIE_SECURE=auto
# Login throttling: this many failures inside the window locks that email (and
# separately that source address) out for the lock duration.
#AUTH_LOGIN_MAX_FAILS=8
#AUTH_LOGIN_WINDOW_SECONDS=900
#AUTH_LOGIN_LOCK_SECONDS=300
# An unaccepted invitation expires after this many days.
#AUTH_INVITATION_TTL_DAYS=7
# Trust X-Forwarded-For / X-Forwarded-Proto when recording session addresses
# and deciding cookie security. Leave false unless a reverse proxy THIS
# deployment controls sets those headers — from anyone else they are lies.
#AUTH_TRUST_PROXY_HEADERS=false
# Display name of the single workspace every account belongs to.
#WORKSPACE_NAME=TechSara's Workspace

# ---------------------------------------------------------------------------
# Optional Compose services and host ports
# ---------------------------------------------------------------------------
# SEARCH_ENABLED=true starts the local SearXNG profile. COMPOSE_PROFILES may
# additionally contain search and/or admin (pgadmin is accepted as an alias).

SEARCH_ENABLED=false
COMPOSE_PROFILES=

FRONTEND_PORT=3000
ORCHESTRATOR_PORT=8080
POSTGRES_PORT=5432
PGADMIN_PORT=5050

# ---------------------------------------------------------------------------
# Network exposure (default: loopback only)
# ---------------------------------------------------------------------------
# TECHSARA_BIND_ADDRESS is the host address the frontend and orchestrator are
# published on. It must be a literal IP address.
#
#   127.0.0.1  (default) reachable only from this machine
#   0.0.0.0              reachable from every host that can route to this
#                        machine
#
# The application now has its own login (see the Authentication section
# above): the UI and the orchestrator API require a signed-in session. Treat
# that as one layer, not a reason to publish ports casually — 0.0.0.0 still
# exposes the login endpoint to password guessing and puts every
# pre-authentication surface on your network. Keep the default unless you
# need remote access, and only widen it on a network you control.
#
# PostgreSQL and pgAdmin always stay on 127.0.0.1 regardless of this setting.
TECHSARA_BIND_ADDRESS=127.0.0.1

# PUBLISH_MODEL_PORTS=true additionally publishes the vLLM/llama.cpp APIs on
# the host, at the ports below. They are UNAUTHENTICATED. Left false, the model
# APIs stay on the internal Docker network where only the orchestrator and sync
# worker can reach them, which is the recommended configuration.
PUBLISH_MODEL_PORTS=false
VLLM_PORT=8000
VLLM_ROUTER_PORT=8002
VLLM_EMBED_PORT=8003
VLLM_OCR_PORT=8004
LLAMA_CPP_PORT=8000

# --- Two-node DGX Spark cluster (added 2026-08-25) ---
# Runs the main model across two DGX Spark hosts (vLLM multi-node "mp"
# executor). `./techsara up` is the one command on every machine:
#
#   CLUSTER_MODE=auto (default, also when the key is absent or empty)
#     On the dgx-spark profile the launcher looks for a second Spark on this
#     node's direct RoCE links (an interface that is up, has an IPv4 address,
#     and sits on an RDMA device), finds the peer from the neighbour table or
#     NVIDIA's .1/.2 convention, and verifies it over ssh (hostname, GB10 GPU,
#     Docker, /dev/infiniband/rdma_cm). When all of that succeeds it generates
#     dual mode, prepares the worker host (scripts/cluster-sync.sh), starts the
#     worker (scripts/cluster-worker.sh start) right before the vLLM head, and
#     `./techsara down` stops the worker too. Otherwise it runs single-node and
#     prints one line saying why ("Cluster: single - ..."). Every other profile
#     (Mac, generic NVIDIA, CPU) runs single-node with no cluster logic at all.
#   CLUSTER_MODE=single  never probe the second Spark; plain single-node.
#   CLUSTER_MODE=dual    require the cluster: an unusable or missing peer is an
#                        error instead of a fallback.
#
# Only the dgx-spark profile supports dual; every other profile rejects
# CLUSTER_MODE=dual. The launcher validates these keys, detects the RoCE
# interface/HCAs, and writes one CLUSTER_ENGINE_ARGS string that both nodes
# interpolate, so the two engines are configured identically. The generated
# TECHSARA_CLUSTER_MODE / TECHSARA_CLUSTER_REASON in .runtime/generated.env
# record what was actually chosen (`./techsara status` shows them).
#
#   CLUSTER_HEAD_IP / CLUSTER_WORKER_IP
#                                   optional overrides (set both or neither): this node's
#                                   and Node 2's RoCE-link IPv4. Empty = discover them.
#   CLUSTER_HEAD_IP_2 / CLUSTER_WORKER_IP_2
#                                   optional second RoCE rail (set both or neither);
#                                   discovered automatically when both nodes have one
#   CLUSTER_WORKER_SSH              optional ssh target for Node 2 (keys only, no
#                                   passwords); default <current user>@<worker ip>
#   CLUSTER_MASTER_PORT             torch.distributed rendezvous port on the head (default 29501)
#   CLUSTER_TENSOR_PARALLEL_SIZE    default 2; CLUSTER_PIPELINE_PARALLEL_SIZE default 1;
#                                   their product must be exactly 2 (one GPU per node)
#   CLUSTER_GPU_MEMORY_UTILIZATION  per-node fraction, 0.05-0.95 (default 0.30)
#   CLUSTER_NCCL_SOCKET_IFNAME      override the detected interface carrying CLUSTER_HEAD_IP
#   CLUSTER_NCCL_IB_HCA             override the detected RDMA devices (comma-separated)
#   CLUSTER_NCCL_DEBUG              VERSION | WARN | INFO (default) | TRACE
#   CLUSTER_SPECULATIVE_CONFIG      JSON object for --speculative-config
#                                   (default {"method":"mtp","num_speculative_tokens":1});
#                                   measured 2026-08-29 on the 35B-A3B: 2 draft
#                                   tokens DROPPED decode from 76-81 to 59-72 tok/s
#                                   (per-token acceptance 62% vs ~95%) - keep 1;
#                                   set it empty to disable speculative decoding
#   CLUSTER_MAX_NUM_BATCHED_TOKENS  default 8192, minimum 256; 16384 measured
#                                   2026-08-29: no prefill gain (3.9-4.0K tok/s
#                                   vs 4.0-5.1K) and a longer compile - keep 8192
#
# The remaining worker-host keys (CLUSTER_WORKER_SSH_OPTS, CLUSTER_WORKER_MODEL_CACHE,
# CLUSTER_WORKER_NCCL_*) are read only by the scripts/cluster-*.sh helpers; see
# docs/CLUSTER.md.
CLUSTER_MODE=auto
CLUSTER_HEAD_IP=
CLUSTER_WORKER_IP=
CLUSTER_HEAD_IP_2=
CLUSTER_WORKER_IP_2=
CLUSTER_WORKER_SSH=
CLUSTER_MASTER_PORT=29501
CLUSTER_TENSOR_PARALLEL_SIZE=2
CLUSTER_PIPELINE_PARALLEL_SIZE=1
CLUSTER_GPU_MEMORY_UTILIZATION=0.30
# Explicit KV-cache budget per node in GiB (2..96, default 16). Set explicitly
# because on GB10 unified memory vLLM's free-memory profiling is unreliable.
# CLUSTER_KV_CACHE_MEMORY_GIB=16
CLUSTER_NCCL_SOCKET_IFNAME=
CLUSTER_NCCL_IB_HCA=
CLUSTER_NCCL_DEBUG=INFO
CLUSTER_SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":1}
CLUSTER_MAX_NUM_BATCHED_TOKENS=8192

# ---------------------------------------------------------------------------
# Search and outbound analysis
# ---------------------------------------------------------------------------
# SearXNG is the local provider. Tavily and Brave send search queries to their
# external APIs and require the matching key. URL and repository analysis also
# make user-requested outbound network requests.

SEARCH_PROVIDER=searxng
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARCH_MAX_RESULTS=100
SEARCH_SOURCE_CHAR_BUDGET=8000
SEARCH_RATE_PER_MIN=10
SEARCH_CACHE_TTL=900
FETCH_TIMEOUT_MS=8000
FETCH_MAX_BYTES=5000000

# --- Web memory, the site crawler and Deep Research -------------------------
# These have shipped since 2026-08-30 with working defaults and were missing
# from this file; they are listed here so the knobs are discoverable.

# V8 web-search memory: every search, link and fetched page is persisted in
# PostgreSQL and embedded into a LanceDB index, so a repeat or related question
# reuses pages already read instead of refetching them. The index is DERIVED —
# deleting LANCEDB_WEB_DIR is safe, PostgreSQL rebuilds it.
WEB_MEMORY_ENABLED=true
LANCEDB_WEB_DIR=/data/lancedb-web
# A stored page younger than this is served without a refetch. "Fresh intent"
# questions ("latest", "today") use the short TTL instead.
WEB_PAGE_TTL_S=86400
WEB_PAGE_FRESH_TTL_S=3600

# V9 site crawler: "index this site <url>" walks one site into the same store,
# sitemap-first and robots-respecting. The caps are the difference between a
# librarian and a vacuum cleaner.
WEB_CRAWL_ENABLED=true
WEB_CRAWL_MAX_PAGES=1000
WEB_CRAWL_MAX_MINUTES=15
WEB_CRAWL_MAX_DEPTH=4
WEB_CRAWL_CONCURRENCY=3
WEB_CRAWL_DELAY_MS=400
# After a search, quietly follow a few in-site links from the pages just read
# so the next related question hits warm content.
WEB_EXPAND_AFTER_SEARCH=true
WEB_EXPAND_PAGES_PER_DOMAIN=8
WEB_EXPAND_MAX_DOMAINS=3
# Background crawl queue (2026-09-03). Sharing a link used to read ONE page
# into ONE conversation. Now the page joins the global corpus and its site is
# queued for a bounded crawl the knowledge worker drains in the background —
# "the whole site" becomes knowledge without anyone waiting in the chat. Deep
# Research queues its top primary domains the same way. Per-job caps; a site
# bigger than them resumes for free on the next share (stored pages cost 0).
WEB_BACKGROUND_CRAWL_ENABLED=true
WEB_SHARE_CRAWL_ENABLED=true
WEB_SHARE_CRAWL_MAX_PAGES=150
WEB_SHARE_CRAWL_MAX_MINUTES=8

# Deep Research: the iterative mode — plan the question into subquestions,
# search, read, audit what is still missing, search again, then write a cited
# report. It is EXPLICIT-only (the composer's "Deep research" row); nothing
# infers it, because it costs minutes and the whole search budget.
#
# The defaults are derived from measurement on the DGX Spark, not taste: the
# main model decodes ~70 tok/s and a guided-JSON planning call costs ~2 s, so
# three rounds plus a ~1500-token report is ~45 s of GPU time; SearXNG answers
# several parallel queries in ~2 s and page extraction is serialised on one
# worker, so the network side dominates. A measured live run: 3 iterations,
# 24 sources, 15 cited, 170 s end to end.
#
# ZERO PAID API: research runs entirely on the local vLLM/Qwen deployment and
# the local SearXNG. No OpenAI/Anthropic/Tavily/Exa/Brave key is required.
DEEP_RESEARCH_ENABLED=true
# CEILING on the loop, not the typical run (2026-09-03): the loop stops on
# EVIDENCE — sufficiency, information gain, duplicate rate, unanswered
# subquestions — and logs why. Each iteration is one search+open+extract
# round plus one gap-analysis call; a verification round counts too.
DEEP_RESEARCH_MAX_ITERATIONS=5
# Searches per round. Google's free CSE endpoint IP-blocked this host during
# testing at roughly 15-20 queries in 3 minutes, and the block outlived
# SearXNG's own 180 s bench — keep this modest.
DEEP_RESEARCH_MAX_QUERIES_PER_ITERATION=5
DEEP_RESEARCH_SOURCES_PER_ITERATION=10
# Total pages read across the whole run (top 10 at ~8000 chars, the rest
# trimmed to 2500 for the report prompt).
DEEP_RESEARCH_MAX_SOURCES=36
# Below this the loop searches the plan's remaining angles instead of asking
# the auditor whether three pages are enough.
DEEP_RESEARCH_MIN_SOURCES=6
DEEP_RESEARCH_TIMEOUT_S=600
DEEP_RESEARCH_REPORT_MAX_TOKENS=6000
# Links opened FROM the pages a round read — the citation an article gives,
# the official page a summary points at, the PDF behind a story. Per round.
DEEP_RESEARCH_LINKS_PER_ROUND=6
# The self-correction pass before the report: audit each subquestion's
# evidence (enough? primary opened? newer source likely? disagreement? a
# change over time mistaken for a contradiction?) and run ONE more targeted
# round when a claim's confidence is below the threshold.
DEEP_RESEARCH_VERIFY=true
DEEP_RESEARCH_MIN_CONFIDENCE=0.6
# Near-duplicate threshold (word-shingle Jaccard): ten syndicated copies of
# one report count as ONE independent source.
DEEP_RESEARCH_DUPLICATE_THRESHOLD=0.6
# Two consecutive rounds adding fewer than this share of new evidence stop
# the loop — the web has been mined for this question.
DEEP_RESEARCH_MIN_GAIN=0.15
# After the report, queue the top primary domains for a bounded background
# crawl so the NEXT question about them answers from the corpus.
DEEP_RESEARCH_BACKGROUND_CRAWL=true
DEEP_RESEARCH_CRAWL_PAGES_PER_DOMAIN=40
DEEP_RESEARCH_CRAWL_MAX_DOMAINS=3

URL_ANALYSIS_ENABLED=true
URL_MAX_PAGES=5
REPO_ANALYSIS_ENABLED=true
REPO_MAX_MB=300
REPO_MAX_FILES=20000
WORKSPACE_TTL_HOURS=24
WORKSPACE_QUOTA_GB=20

# ---------------------------------------------------------------------------
# Application behavior (not serving topology)
# ---------------------------------------------------------------------------
# Per-role contexts are launcher-managed and clamped to the selected manifest;
# the MAIN model's window is yours to set below (MAIN_MODEL_MAX_LEN). These are
# application-side budgeting/features only.

MODEL_MAX_OUTPUT=8192
CONTEXT_SAFETY_MARGIN=512
TOKENIZE_TIMEOUT=5.0

# --- Main model window and serving parameters -------------------------------
# MAIN_MODEL_MAX_LEN is THE knob for the main model's context window. It
# REPLACES the window the launcher's profile would pick and moves everything
# derived from it together: --max-model-len on the vLLM command line (both
# nodes in cluster mode) and MODEL_MAX_CONTEXT / DEFAULT_MAX_CONTEXT /
# REPORT_MAX_CONTEXT / MAIN_CONTEXT_LENGTH for the application. Leave it unset
# for today's behaviour - the profile chooses (262,144 on the DGX Spark).
# Range: 4096 to 1048576; `./techsara up` refuses anything outside it.
#
# ASKING FOR MORE THAN THE MODEL'S NATIVE WINDOW TURNS ON YaRN AUTOMATICALLY.
# nvidia/Qwen3.6-35B-A3B-NVFP4 is natively 262,144 tokens, so a longer window
# adds this to the engine command line on every node:
#
#     --hf-overrides '{"text_config":{"rope_parameters":{...,"rope_type":"yarn",
#       "factor":<requested/native>,"original_max_position_embeddings":262144}}}'
#
# (the nesting under text_config is mandatory - vLLM silently ignores the
# top-level spelling for this model class). That is a real extension and a real
# trade: YaRN interpolates the rope for every prompt, so short-prompt quality
# gives up a little to make the long window work. Four times the native window
# is the supported ceiling; above that the launcher refuses rather than serve a
# window the model cannot hold together.
#
# KV CACHE IS THE CONSTRAINT THE LAUNCHER CHECKS. Only a hybrid model's
# full-attention layers page a KV cache (the gated-delta-net layers keep a
# per-sequence state that does not grow with the prompt). The launcher reads
# the geometry from the model's config.json, so the numbers follow the model:
#
#   nvidia/Qwen3.6-35B-A3B-NVFP4 (current): 10 of 40 layers, 2 KV heads x 256
#     -> 10,240 bytes/token at TP=1, 5,120 at TP=2 (--kv-cache-dtype fp8)
#   RadixArk/Qwen3.8-27B-NVFP4 (previous):  16 of 64 layers, 4 KV heads x 256
#     -> 32,768 bytes/token at TP=1, 16,384 at TP=2
#
# vLLM needs the pool to hold one whole max-length request, so on the two-node
# cluster
#
#     CLUSTER_KV_CACHE_MEMORY_GIB * 1024^3 * 0.88 / bytes_per_token  >=  MAIN_MODEL_MAX_LEN
#
# and `up` fails fast with that arithmetic (and the GiB it would take) when it
# does not hold. The 0.88 is not a fudge factor: on a HYBRID model the
# gated-delta-net layers take their per-sequence state out of the same
# --kv-cache-memory-bytes budget, so only ~88% of it becomes paged tokens. Both
# models confirmed it on the running cluster: a 16 GiB budget is 1,048,576
# tokens of naive arithmetic for the 27B and the engine reported a "GPU KV
# cache size: 933,232 tokens" pool (89.0%); for the 35B it is 3,355,443 naive
# and the engine reports 2,977,319 (88.7%). With the 35B the KV pool therefore
# no longer binds at all: the hard ceiling is the 4x-native YaRN limit
# (1,048,576 tokens) the launcher enforces. With the 27B the usable pool was
# ~922,746 tokens, so ~838,860 tokens (3.2x) was the practical ceiling. On a
# single node the pool is profiled at start-up instead, so the launcher only
# prints the estimated GiB and leaves the decision to vLLM.
#
# MODEL_MAX_CONTEXT is still accepted as a deprecated alias when
# MAIN_MODEL_MAX_LEN is unset - it used to be silently ignored, because the
# launcher writes it into .runtime/generated.env and that is the last
# --env-file Compose reads. Use MAIN_MODEL_MAX_LEN.
#
# Verify what is actually being served:
#
#     curl -s localhost:8080/health | jq .context
#
# and prove the window end to end (real tokenizer, needle retrieval at the
# start/middle/end of the prompt) with:
#
#     orchestrator/.venv/bin/python orchestrator/scripts/validate_long_context.py
#
#MAIN_MODEL_MAX_LEN=262144
# Production on the two-node cluster runs MAIN_MODEL_MAX_LEN=1000000 since
# 2026-08-29 (YaRN 3.82), needle-verified at 949,915 tokens with full recall.
#
# THE PAIR THAT MATTERS: MAIN_MODEL_MAX_LEN and CLUSTER_KV_CACHE_MEMORY_GIB
# come out of the SAME unified pool. At the old 16 GiB the KV cache reserved
# room for 2.95M tokens - three times what a 1M window can ever use - and a
# 949,915-token prompt exhausted the rest and restarted the engine. At 8 GiB
# the pool still holds 1,494,824 tokens (one full 1M request + ~50% margin)
# and prefill working memory goes from ~19 GiB to ~37 GiB; the same prompt
# then completes and recalls needles at the start, middle and end.
# So: a bigger window wants a SMALLER KV budget, not a larger one. Verify any
# change with orchestrator/scripts/validate_long_context.py - a prefill that
# merely returns 4 tokens is not a safety test.
# Output reservation. High effort gets the larger one: a multi-step comparison
# that states its assumptions runs long, and truncating a conclusion is the
# worst place in an answer to run out of room.
MAIN_MODEL_DEFAULT_MAX_OUTPUT_TOKENS=8192
MAIN_MODEL_HIGH_MAX_OUTPUT_TOKENS=16384
# Headroom on a FULL-WINDOW request, distinct from CONTEXT_SAFETY_MARGIN above
# (the small per-call slack every request already leaves). At 262144 the
# documented budget is 262144 − 16384 − 8192 = 237568 tokens of input.
MAIN_MODEL_CONTEXT_SAFETY_MARGIN=8192
# Mirrors of the vLLM launch flags, so /health can report what the app BELIEVES
# it is running against and a drift from the actual command is visible.
# MAIN_MODEL_MAX_NUM_SEQS=0 means "left at the vLLM default", which is
# deliberate on the shared DGX server — see the note in docker-compose.yml.
MAIN_MODEL_MAX_NUM_SEQS=0
MAIN_MODEL_MAX_BATCHED_TOKENS=8192
MAIN_MODEL_KV_CACHE_DTYPE=fp8
MAIN_MODEL_ENABLE_PREFIX_CACHING=true
MAIN_MODEL_ENABLE_CHUNKED_PREFILL=true
# Set true only when the main vLLM is launched with --enable-auto-tool-choice
# and --tool-call-parser. It is a hint that saves a failed round trip: the
# planner tries tool calling first and falls back to guided JSON on a 400, so a
# wrong value here costs latency, never correctness.
MAIN_MODEL_ENABLE_AUTO_TOOL_CHOICE=true

# --- Salesforce Intelligence Mode -------------------------------------------
# The Salesforce pill stops being a retrieval filter and becomes a context-aware
# agent: it resolves "what about EMEA?" against the conversation, asks ONE
# targeted question when a missing detail would materially change the answer,
# and RESUMES the original request once that question is answered.
#
# Off → the deterministic detectors in app/core/clarify.py decide instead of the
# model, through the SAME persisted, resumable, loop-guarded card. This switches
# the PLANNER, not the clarification system: `meta.salesforce_mode` reports
# "intelligence" or "deterministic" so which one ran is never invisible.
SALESFORCE_INTELLIGENCE_MODE_ENABLED=true
# Turn only the QUESTIONS off: context resolution still runs, so follow-ups keep
# working, but the assistant never interrupts — it states its assumptions.
SALESFORCE_CONTEXTUAL_CLARIFICATION_ENABLED=true
# The suggestion strip above an empty composer while Salesforce is on.
SALESFORCE_STARTER_CARD_ENABLED=true
# Two rounds, then answer with the safest reading and SAY so. A third round has
# never been the difference between a right and a wrong answer; it is an
# interrogation.
SALESFORCE_MAX_CLARIFICATION_ROUNDS=2
SALESFORCE_ALLOW_CUSTOM_CLARIFICATION=true
# When to ask at all. `ambiguous` (the default) asks only when two readings
# would return different records; `off` never asks, and context resolution still
# runs so follow-ups keep working; `always` LOWERS THE BAR for the planner —
# it is a bias, not a confirmation card on every question, which is what it used
# to be and which nobody could answer without re-reading their own sentence.
CLARIFY_MODE=ambiguous
# Let one card take several answers. The planner overrides this per question by
# setting multi_select explicitly: "which objects hold this?" can honestly be
# answered with two, "interviews or the candidates who sit them?" cannot.
SALESFORCE_MULTI_SELECT_CLARIFICATION=true
# Defaults to MAIN_MODEL_ENABLE_AUTO_TOOL_CHOICE; set false to force the planner
# onto guided JSON even on a runtime that supports tool calling.
#SALESFORCE_PLANNER_TOOL_CALLING=true
ROUTER_INPUT_CHAR_CAP=6000
EMBED_INPUT_CHAR_CAP=8000

# --- The Salesforce brain -----------------------------------------------------
# Knowledge packs the Salesforce team drops into brain/packs/ (mounted read-only
# at /data/brain). Rules, canonical metrics, glossary and documentation flow
# into every Salesforce-mode prompt; see brain/README.md and app/core/brain.py.
BRAIN_ENABLED=true
BRAIN_MAX_CHARS=40000
# Learn-from-chat: thumbs-up answers whose SQL was stored become few-shot
# examples for similar future questions; a thumbs-down anywhere disqualifies
# that SQL globally (app/core/learned_examples.py).
LEARNED_EXAMPLES_ENABLED=true
LEARNED_EXAMPLES_K=2

CONTEXT_WARN_THRESHOLD=0.60
CONTEXT_BG_COMPACT_THRESHOLD=0.70
CONTEXT_COMPACT_THRESHOLD=0.80
KEEP_RECENT_TURNS=8
SUMMARY_MAX_TOKENS=2000
MIN_OUTPUT_FLOOR=1024
SEMANTIC_RECALL_ENABLED=true
RETRIEVE_TOP_K=6
CONTEXT_METER_ENABLED=true

# Charts: explicit (only when requested) or hybrid (also deterministic,
# high-confidence result shapes). There is no automatic mode.
# hybrid: a chart the user asked for still always appears (typo-tolerant since
# 2026-08-18 — "bar chat" counts), PLUS four deterministic high-confidence
# shapes chart themselves: a time series, a trusted Salesforce stage funnel,
# a small part-to-whole, and a single-dimension category comparison. A wrong
# automatic chart is worse than no chart, so the shapes are narrow on purpose
# and "just the table" always suppresses. `explicit` restores ask-only.
CHART_TRIGGER_MODE=hybrid
CHART_FUNNEL_STAGE_ORDER=

# Upload/archive bounds.
DATASET_UPLOADS_ENABLED=true
UPLOAD_MAX_MB=200
ARCHIVE_MAX_UNCOMPRESSED_MB=2048
ARCHIVE_MAX_FILES=10000
ARCHIVE_MAX_RATIO=200
ARCHIVE_MAX_DEPTH=1

# Salesforce sync behavior. Sync can keep the DuckDB/Parquet warehouse current
# when embeddings are unavailable; vector index updates then degrade safely.
SYNC_INTERVAL_MINUTES=5
SYNC_AUTO_FIELDS=true

# Timezone the typed warehouse views render DateTime columns in.
# Salesforce STORES every DateTime in UTC and DISPLAYS it in the reading
# user's zone, so set this to your org's zone (Setup -> Company Information,
# or the majority value of User.TimeZoneSidKey). Then "how many interviews
# today" means the same day your team sees in Salesforce.
# Leave as UTC to store and read UTC unchanged.
SF_ORG_TIMEZONE=UTC
SYNC_AUTO_OBJECTS=true
SYNC_MAX_FIELDS=4000
SYNC_REPORT_NEW_OBJECTS=true

# Frontend development/demo options.
MOCK_MODE=false
NEXT_PUBLIC_APP_NAME=TechSara AI

# ---------------------------------------------------------------------------
# Explicit local external-development profile (optional)
# ---------------------------------------------------------------------------
# Used only with: ./techsara up --profile external-development
# URLs must be explicit local/container HTTP(S) endpoints. Public/cloud hosts,
# embedded URL credentials, and automatic cloud fallback are rejected.
#
#OPENAI_BASE_URL=http://host.docker.internal:8000/v1
#MAIN_MODEL=your-local-served-model
#OPENAI_API_KEY=
#ROUTER_BASE_URL=http://host.docker.internal:8000/v1
#ROUTER_MODEL=your-local-served-model
#EMBED_BASE_URL=http://host.docker.internal:8001/v1
#EMBED_MODEL=your-local-embedding-model
#EMBED_API_KEY=
#RERANK_BASE_URL=http://host.docker.internal:8002
#RERANK_MODEL=your-local-reranker
#RERANK_API_KEY=
#OCR_BASE_URL=http://host.docker.internal:8003/v1
#OCR_MODEL=your-local-ocr-model
#
# External capability declarations are conservative. Set only capabilities the
# local endpoint actually implements, for example:
#MAIN_ENABLED=true
#MAIN_SUPPORTS_CHAT=true
#MAIN_SUPPORTS_STREAMING=true
#MAIN_SUPPORTS_TOOL_CALLING=false
#MAIN_SUPPORTS_STRUCTURED_OUTPUT=false
#MAIN_SUPPORTS_VISION=false
#MAIN_CONTEXT_LENGTH=8192
#MAIN_OUTPUT_LIMIT=2048
#MAIN_CONCURRENCY=1

# ---------------------------------------------------------------------------
# Host-launcher environment (set in the shell, not this file)
# ---------------------------------------------------------------------------
# These values are needed before .env is parsed. Export/set them in the shell
# that starts the wrapper:
#
#   TECHSARA_HOME             shared uv/runtime/download root
#   TECHSARA_MODEL_CACHE      model cache override
#   TECHSARA_GPU_SMOKE_IMAGE  image used for the container GPU probe; by default
#                             the launcher prefers an already-cached runtime
#                             image and otherwise pulls one digest-pinned ~4 MiB
#                             image
#
# POSIX example:
#   export TECHSARA_HOME="$HOME/.techsara"
#   export TECHSARA_MODEL_CACHE="$HOME/.cache/techsara/models"
#
# PowerShell example:
#   $env:TECHSARA_HOME = "$HOME\.techsara"
#   $env:TECHSARA_MODEL_CACHE = "$env:LOCALAPPDATA\TechSara\models"
#
# At present, placing these two variables only in .env does not configure the
# host bootstrap/detector. They must be process environment values.

# --- Public access (optional): Cloudflare Tunnel ---------------------------
# Serves the workspace at a public hostname WITHOUT a public IP, port
# forwarding or firewall changes: cloudflared dials out to Cloudflare and only
# the hostname you map in the dashboard is reachable. See docs/AUTH.md.
#   scripts/tunnel.sh up | down | status | check
# The token is issued by Cloudflare (Zero Trust -> Networks -> Tunnels) and
# belongs in .runtime/secrets.env, NEVER here and never in git.
#CLOUDFLARE_TUNNEL_TOKEN=            # -> .runtime/secrets.env
#PUBLIC_HOSTNAME=ai.example.com
# Behind TLS, these three are required. AUTH_COOKIE_SECURE must be `true`, not
# `auto`: the orchestrator itself is reached over plain HTTP inside Docker, so
# `auto` would ship session cookies without the Secure flag on an HTTPS site.
#AUTH_COOKIE_SECURE=true
#AUTH_TRUST_PROXY_HEADERS=true
#CORS_ALLOW_ORIGINS=https://ai.example.com

# Bind address for the UNAUTHENTICATED model APIs (8002-8005), separate from
# TECHSARA_BIND_ADDRESS so opening the app to your LAN does not also open four
# model endpoints that have no login. Leave on loopback unless you have a
# specific reason: nothing in the app needs them published (the orchestrator
# and Prometheus both reach them by service name on the Docker network).
#TECHSARA_MODEL_BIND_ADDRESS=127.0.0.1

# --- Living knowledge layer (2026-09-01) -----------------------------------
# Makes even Fast mode current WITHOUT turning every question into a search.
# Before this, web memory was reachable only from inside the search engine, so
# a Fast/search-off chat answered from the model's frozen weights while pages
# already stored on disk held the current answer. See docs/FLOWS.md.
#LIVING_KNOWLEDGE_ENABLED=true
# Ask the 8B router when the lexical freshness rules are ambiguous. Off => an
# ambiguous question defaults to RECENT, costing a local lookup rather than a
# wrong answer. The deterministic pass settles ~96% of real questions.
#FRESHNESS_ROUTER_ENABLED=true
# What Fast mode may spend when a question IS time-sensitive and the local
# corpus cannot answer it. A full web search reads 5-8 pages; this reads two.
#FRESHNESS_FAST_LOOKUP=true
#FRESHNESS_FAST_SOURCES=2
# 12 → 8 s (2026-09-03): the worst case a Fast answer waits before it starts.
#FRESHNESS_FAST_DEADLINE_S=8.0
# How much locally-read evidence a grounded answer carries (characters of
# passages). 900 was one paragraph; 3600 is several focused passages, ~1k
# tokens of prefill — well under half a second on this deployment.
#LIVING_KNOWLEDGE_EVIDENCE_CHARS=3600
# Topical grounding (2026-09-03): a TIMELESS question is also answered from
# the corpus when a strongly matching passage exists — a site the user
# indexed, a document a research run read. That is what makes a shared site
# a knowledge base for every user. Gated on a strong hybrid score AND the
# question's own words being on the page, so ordinary chat never drags in a
# loosely related page.
#LIVING_KNOWLEDGE_TOPICAL=true
#LIVING_KNOWLEDGE_TOPICAL_MIN_SCORE=0.66

# --- Attachment latency (2026-09-03) ---------------------------------------
# The OCR sidecar transcribes BEFORE the main model can start. On a text-dense
# screenshot at Think that measured 47 s to the first visible token. The image
# route now caps the transcript and waits at most this long, then proceeds
# from the pixels. PDF pages (scans) keep the full OCR budget.
#OCR_VISION_DEADLINE_S=10.0
#OCR_VISION_MAX_TOKENS=1500
# Extract a document the moment it finishes uploading (text layer, page
# renders, OCR of scanned pages) so the send that follows reads a cache.
#DOCUMENT_PREWARM_ENABLED=true
#DOCUMENT_PREWARM_MAX_MB=64
# The background keeper: drains the embedding backlog (previously only ever
# advanced by someone running a search) and re-reads pages past their TTL,
# most-retrieved first. Runs in the orchestrator process; the queue is a
# PostgreSQL column, so a restart resumes rather than forgets.
#WEB_KNOWLEDGE_WORKER_ENABLED=true
#WEB_WORKER_INTERVAL_S=300
#WEB_REFRESH_MAX_PAGES_PER_CYCLE=8
#WEB_REFRESH_CONCURRENCY=2
# Per-volatility re-read deadlines. Inferred from the page, not a URL list.
#WEB_REFRESH_REALTIME_TTL_S=21600
#WEB_REFRESH_RECENT_TTL_S=86400
#WEB_REFRESH_STATIC_TTL_S=1814400
