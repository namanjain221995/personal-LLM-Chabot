<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Expected_No_of_Interviews__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
  TODAY() -  Application_Start_Date__c  &lt;= 15,
  5,
  5 + CEILING((TODAY() -Application_Start_Date__c - 15) / 30) * 10
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Expected No of Interviews</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
