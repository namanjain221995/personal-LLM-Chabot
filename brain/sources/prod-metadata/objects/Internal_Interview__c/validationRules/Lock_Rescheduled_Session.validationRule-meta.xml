<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lock_Rescheduled_Session</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT(ISNEW()),
ISPICKVAL(PRIORVALUE(Status__c), &quot;Rescheduled&quot;)

)</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>This record is locked because the session status is already Rescheduled.</errorMessage>
</ValidationRule>
