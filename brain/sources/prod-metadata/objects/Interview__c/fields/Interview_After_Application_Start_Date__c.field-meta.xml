<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Interview_After_Application_Start_Date__c</fullName>
    <formula>AND(
  NOT(ISBLANK(Date_of_Interview__c)),
  NOT(ISBLANK(Candidate__c)),
  Date_of_Interview__c &gt;= Candidate__r.Application_Start_Date__c
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Interview After Application Start Date</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
