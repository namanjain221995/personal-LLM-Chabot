<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Offer_Requires_OfferLetterDate</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Interview_Status__c, &quot;Offer Received&quot;),
    ISBLANK(Offer_Letter_Date__c)
)</errorConditionFormula>
    <errorMessage>Offer Letter Date must be populated before moving Interview Status to &apos;Offer Received&apos;.</errorMessage>
</ValidationRule>
