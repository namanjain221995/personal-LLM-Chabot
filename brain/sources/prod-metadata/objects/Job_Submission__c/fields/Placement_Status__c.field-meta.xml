        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Not Placed</fullName>
                <default>false</default>
                <label>Not Placed</label>
            </value>
            <value>
                <fullName>Offered</fullName>
                <default>false</default>
                <label>Offered</label>
            </value>
            <value>
