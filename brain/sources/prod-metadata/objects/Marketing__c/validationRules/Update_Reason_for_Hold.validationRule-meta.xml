<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Update_Reason_for_Hold</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c , &apos;Paused&apos;),
    ISBLANK(Reason_for_paused__c)
)</errorConditionFormula>
    <errorMessage>Please fill in the details. Reason for pausing</errorMessage>
</ValidationRule>
