<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ATS_Score_below_75</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
 ISPICKVAL(Status__c,&apos;Onboarding Completed&apos;) ,
OR(ATS_Score__c &lt; 75, ISNULL(ATS_Score__c))
)</errorConditionFormula>
    <errorMessage>ATS Score needs to be at least 75</errorMessage>
</ValidationRule>
