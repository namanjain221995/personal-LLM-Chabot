<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Service_Agreement_Required_Before_Resume</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 ISPICKVAL(Status__c  , &apos;Resume Creation&apos;) ,
NOT( Service_Agreement_Signed__c )
)</errorConditionFormula>
    <errorMessage>Get the Service Agreement signed before starting on the Resume.</errorMessage>
</ValidationRule>
