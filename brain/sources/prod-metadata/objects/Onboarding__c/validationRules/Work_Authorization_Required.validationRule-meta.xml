<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Work_Authorization_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 ISPICKVAL(Status__c  , &apos;Onboarding Completed&apos;) ,
ISNULL(  Text(Work_Authorization__c) )
)</errorConditionFormula>
    <errorDisplayField>Work_Authorization__c</errorDisplayField>
    <errorMessage>Get the candidate approval of the resume before completion of the onboarding</errorMessage>
</ValidationRule>
