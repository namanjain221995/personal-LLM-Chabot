      Component(c_png, "charts_png.py", "231 LOC · matplotlib Agg", "render_chart_png (:69-133) — the only SERVER-side renderer, for pandoc embedding. PNG_SUPPORTED = 8 types, funnel excluded (:41-48). The browser draws the same spec with ECharts.", $tags="data")
      Component(c_exp, "exports.py + report_paths.py", "125 + 69 LOC", "cap_rows / apply_export_cap (PREVIEW 500, EXPORT 100 000) + export_csv / export_xlsx into REPORTS_DIR; resolve_report_file rejects .., separators, absolutes, dotfiles, NUL and symlink escape (report_paths.py:23-48).", $tags="data")
    }

    Boundary(ci, "core/ — INGESTION & EXTRACTION", "package", $tags="pkg") {
      Component(c_extract, "extract.py + pdf.py", "108 + 67 LOC", "extract_readable(content_type, body) -> trafilatura / pypdfium2 / tag-strip; render_pdf -> <=6 pages at scale 2.0 as PNG data URLs plus <=24 000 chars of text layer (pdf.py:18-20).", $tags="data")
