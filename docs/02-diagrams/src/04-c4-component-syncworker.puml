Boundary(sw, "sync-worker — one container, ONE thread, ZERO async (Dockerfile:34 `python -m syncworker.main`, uid 10001)", "container", $tags="pkg") {

  Component(m_main, "main.py", "the loop · 305 LOC · sync_object = 89 LOC", "while not flag.stop: open Store -> run_cycle -> close Store -> sleep(SYNC_INTERVAL_MINUTES × 60). Per object: watermark -> describe/adopt -> full|incremental pull -> per-batch land -> watermark commit (:106-194). Backoff 30 s doubling to a 30 min cap (:29-30,:298-299).", $sprite="cogs", $tags="app")

  Boundary(auth, "credential + auth path", "package", $tags="pkg") {
    Component(m_secrets, "secrets.py", "181 LOC · env only", "credentials_from_env resolution order (:118-160): (1) SF_CLIENT_SECRET short-circuits everything (:130-138); (2) SF_PRIVATE_KEY_FILE (:140); (3) SF_PRIVATE_KEY_B64, base64 validate=True (:141,144-149); (4) /data/sf_jwt_key.pem if it exists (:150-151); else None. __repr__/__str__ redact (:92-95).", $sprite="lock", $tags="app")
    Component(m_auth, "sf_auth.py", "129 LOC · PyJWT RS256 + httpx", "build_jwt_assertion -> claims {iss, sub, aud, exp = now + 180} (:32-38). TokenManager caches the access token for TOKEN_TTL_SECONDS = 25 min (:47) and refreshes reactively via invalidate() on a 401 (:70-73). client_secret present -> client_credentials grant instead, no JWT (:78-90).", $sprite="shield_alt", $tags="app")
  }

  Boundary(pull, "extraction path", "package", $tags="pkg") {
    Component(m_client, "sf_client.py", "258 LOC · httpx timeout 120 s", "Read-only by construction: GET/POST only (:132-133), Bulk operations limited to query|queryAll (:195-196), object + every field checked against ^[A-Za-z][A-Za-z0-9_]*$ (:78-83) and the watermark against a strict datetime regex (:96). bulk_query and soql_query are GENERATORS — pagination is lazy.", $sprite="cloud", $tags="app")
    Component(m_objects, "objects.py", "394 LOC · CLI, not the loop", "`python -m syncworker.objects` list|add|add-fields|remove|import-sheet. Intersects an org 'Objects, Fields' spreadsheet with what the integration user can actually read via a live describe, then REWRITES config.yaml (:149-152).", $sprite="server", $tags="app")
  }

  Boundary(land, "landing + indexing path", "package", $tags="pkg") {
    Component(m_storage, "storage.py", "167 LOC · duckdb + pyarrow", "normalize_records (:38-56) casts EVERY value to str|None; write_parquet_batch -> PARQUET_DIR/<obj>/<obj>_<stamp>_<uuid8>.parquet (:59-69); Store.upsert = BEGIN -> ALTER ADD COLUMN for drift -> DELETE WHERE Id IN (staging) -> INSERT BY NAME -> COMMIT, ROLLBACK on any error (:124-167). Watermarks live in `_sync_meta` (:23,:92-106).", $sprite="database", $tags="app")
    Component(m_rag, "rag_index.py", "154 LOC · lazy lancedb", "OpenAIEmbedder.embed slices into fixed windows of EMBED_BATCH_SIZE = 32 (:25,:45-46). RagIndexer.index_records builds {text, object, record_id, field, system_modstamp} rows, embeds the whole batch in one call (:128), then DELETES ONE FILTER PER RECORD and re-adds (:141-144).", $tags="app")
    Component(m_chunk, "chunking.py", "41 LOC · pure, stdlib-free", "chunk_text(text, 800, 100) — sliding windows of whitespace-separated words with 100-word overlap, step 700 (:10-11,:34-40). Not configurable anywhere; rag_index.py:116 passes neither argument.", $tags="app")
  }

  Boundary(sup, "configuration + observability", "package", $tags="pkg") {
    Component(m_config, "config.py + config.yaml", "87 + 852 LOC", "Frozen Settings from 11 env vars (:33-51). load_object_configs validates every object/field name, requires Id AND SystemModstamp, and requires every rag_field to appear in fields (:61-87). config.yaml holds 48 objects · 631 fields · 61 rag_fields across 34 objects.", $tags="app")
    Component(m_log, "jsonlog.py", "39 LOC", "One JSON object per line on stdout; every `extra=` key is promoted verbatim into the payload (:26-28). json.dumps(default=str) (:31) means a log call can never crash the worker.", $sprite="file_alt", $tags="app")
  }
}

