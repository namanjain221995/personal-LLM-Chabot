title C4 L3 — **frontend** internals: 10 App-Router API routes, the lib/ layer, the component tree\nThe SSE answer path is drawn thick in edge blue\n(evidence: frontend/lib/streams.ts:307-348 · frontend/lib/sse.ts:283-301 · frontend/app/api/chat/route.ts:123-185 · frontend/components/ChatApp.tsx:254-273)

Container_Boundary(fe, "frontend — Next.js 15 App Router · React 19 · TypeScript · output:'standalone'") {

  Boundary(browser, "Browser bundle — no auth, no CSP, no middleware.ts (next.config.mjs:1-8)", "client components", $tags="trust") {

    Component(chatapp, "ChatApp", "client component · 916 LOC", "The god component (847 LOC in one function).\n14 useState · 6 useRef · 5 useEffect · 14 useCallback.\nOwns messages, streaming flag, prefs, reconcile lock.\nPolls /api/chat/active every 8000 ms (:301).", $tags="ui", $sprite="react_original")

    Component(composer, "Composer", "client component · 423 LOC", "Auto-grow textarea, attachment classify + size caps\n(image 10 MB · PDF 25 MB · dataset 200 MB — CLIENT-SIDE ONLY),\npaste capture, Salesforce pill, ModelPicker, Send/Stop.", $tags="ui")

    Component(messagerow, "MessageRow", "client component · 232 LOC", "One turn. **Not React.memo** — re-renders on every token.\nOrder: ReasoningAccordion → ResearchPanel → AgentTimeline →\nMarkdown → trim notice → error block → ProofDrawer.", $tags="ui")

    Component(markdown, "Markdown + MermaidBlock", "react-markdown 10 · remark-gfm · mermaid 11", "No rehype-raw → raw HTML is downgraded to text.\nmermaid securityLevel:'strict' → DOMPurify on both\ndangerouslySetInnerHTML sites (MermaidBlock.tsx:311,420).", $tags="ui")

    Component(proof, "ProofDrawer", "client component · 160 LOC", "The 'proof' bar built imperatively from `meta`:\nSqlBlock · CitationChips · WebSources · CodeCitations ·\nDataTable (≤500 rows, unvirtualised) · ChartView · FileCards.", $tags="ui")

    Component(chart, "ChartView → EChart", "next/dynamic ssr:false · Apache ECharts", "ChartErrorBoundary — the app's ONLY React error boundary\n(ChartView.tsx:87). 5 series types + CanvasRenderer registered.\nNo reset path once failed (ChartErrorBoundary.tsx:29,47).", $tags="ui")

    Component(chartlib, "lib/chartOption · chartTheme · chartFormat", "TypeScript · 861 LOC · pure", "The documented trust boundary for chart rendering:\n`type` is whitelist-checked, x_key/y_keys are only property\nlookups, every formatter is local, escapeHtml on tooltips.", $tags="libc")

    Component(sidebar, "Sidebar + ConversationMenu", "client components · 652 LOC", "Pinned / Recents / Archived rail, inline rename, per-row menu,\nspinner driven by streamingIds, theme toggle.\n`body` is rendered TWICE (desktop aside + mobile drawer).", $tags="ui")

    Component(meter, "ContextMeter + lib/contextMeter", "client + pure · 349 LOC", "Ring + breakdown popover + 'Compact now'.\nBudget constants 131072 / 8192 / 512 are hardcoded here and\nduplicate orchestrator/app/config.py:127,128,131.", $tags="ui")

    Component(timeline, "AgentTimeline + ResearchPanel", "client components · 331 LOC", "Numbered agent steps (from `step` frames) and the web-research\npanel (from `research` frames): domains, elapsed, per-query hits.", $tags="ui")

    Component(palette, "SearchPalette + lib/searchPalette", "client + pure · 828 LOC", "Ctrl/Cmd+K modal. Debounced, one AbortController at a time,\nTab-trapped, portalled to document.body.", $tags="ui")

    Component(streams, "lib/streams.ts", "TypeScript · 393 LOC · MODULE STATE", "**The live-generation registry.** `streams` Map(convId → LiveStream)\nand `listeners` Set live for the tab's lifetime.\nstartStream · attachStream · stopStream · fetchServerActive ·\nconsume() = 90 LOC, 8-arm event reducer.", $tags="libc")

    Component(ssel, "lib/sse.ts", "TypeScript · 301 LOC · pure", "Hand-rolled CRLF-safe SSEParser, toChatStreamEvent (97 LOC),\nmergeStep, foldStreamState, readChatStream async generator.\nDeliberately NOT the Vercel AI SDK — it drops the `meta` event.", $tags="libc")

    Component(hist, "lib/history.ts + lib/historyApi.ts", "TypeScript · 1107 LOC", "localStorage cache `techsara.history.v1` with quota eviction,\nper-conversation push/pull chains, prefix-delta sync,\n409-on-shrink recovery. createServerHistoryStore = 470 LOC.", $tags="libc")

    Component(prefs, "lib/prefs.ts · attachments.ts · pasted.ts", "TypeScript · 282 LOC", "Per-conversation composer prefs in localStorage (cap 200 entries);\nin-memory Map of raw attachment base64 for regenerate/retry —\nnever evicted, never bounded.", $tags="libc")

    Component(contract, "lib/types.ts + lib/errors.ts", "TypeScript · 366 LOC · declaration + pure", "Meta / ChatMessage / Engine / ChartSpec unions consumed by\n37 modules, plus friendlyError() regex classifier.\nCompile-time only — nothing checks them at runtime.", $tags="libc", $sprite="typescript")
  }

  Container_Boundary(nodeside, "Next.js server runtime — all 10 routes are runtime:'nodejs' + dynamic:'force-dynamic', and ZERO of them authenticate") {

    Component(rchat, "POST /api/chat", "app/api/chat/route.ts · 185 LOC", "The SSE chat endpoint. Buffers the whole JSON body,\nMOCK_MODE short-circuit to an 82-LOC fixture stream,\nthen pipes upstream.body through untouched (:184).", $tags="route", $sprite="nextjs")

    Component(rattach, "GET /api/chat/attach/{id}", "attach/[id]/route.ts · 67 LOC", "Re-join a detached generation. The ONLY dynamic route that\nguards decodeURIComponent (:27-32). SAFE_ID = ^[\\w-]{1,64}$\nmatches history.py:34 exactly — no traversal possible.", $tags="route")

    Component(rctl, "POST /api/chat/stop · /compact + GET /api/chat/active", "3 route handlers · 95 LOC", "Raw `await req.text()` passthrough for stop/compact —\nneither body is parsed or validated here.\nreq.signal is NOT forwarded on any of the three.", $tags="route")

    Component(rhist, "GET|POST|PUT|DELETE /api/history/{...path}", "history/[...path]/route.ts · 73 LOC", "Allow-listed CRUD proxy: `search` (GET) or `conversations`\nwith ≤3 segments; anything else 404s. Query params are\nrebuilt from an explicit allowlist (q, limit, archived).", $tags="route")

    Component(rup, "POST /api/upload", "upload/route.ts · 47 LOC", "Multipart STREAMED to the orchestrator (`duplex:'half'`) —\nthe only route that does not buffer. No content-type, size,\nfield or filename check of its own.", $tags="route")

    Component(rmisc, "GET /api/auth/me · /api/reports · /api/reports/{filename}", "3 route handlers · 140 LOC", "Identity (used only to scope the localStorage key),\nreport listing and report download proxy.", $tags="route")

    Component(proxy, "lib/proxy.ts", "TypeScript · 64 LOC", "proxyToOrchestrator(): forwards ONLY `cookie` + `content-type`,\nbuffers req.text() up and upstream.arrayBuffer() down,\nredirect:'manual', re-emits every upstream Set-Cookie verbatim.", $tags="libc")

    Component(orchlib, "lib/orchestrator.ts", "TypeScript · 101 LOC · pure", "The wire contract: ChatRequestBody → OrchestratorChatRequest.\nlastUserContent() + IMAGE_ONLY_PROMPT / PDF_ONLY_PROMPT.\nReturns null (→ 400) when there is nothing to send.", $tags="libc")
  }
}

System_Ext(orc, "orchestrator", "FastAPI · uvicorn · host :8080 — no auth, no rate limit", $tags="ext")

