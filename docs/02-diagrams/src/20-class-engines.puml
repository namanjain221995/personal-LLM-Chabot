' The contract — duck-typed, no ABC, no Protocol
' ═══════════════════════════════════════════════════════════════════
interface "EngineContract" as EC <<implicit — NOT enforced>> #FEF9C3 {
  //There is no ABC, no Protocol, no base class.//
  //engines/__init__.py holds only recent_turns() and//
  //3 prompt constants — __init__.py:6, :24, :35, :57//
  ..expected shape (by convention only)..
  +{abstract} async run_<x>_engine(
  +    message: str,
  +    history: Sequence[dict],
  +    emit: Emit) : str
  ..type alias, re-declared **12 times** independently..
  Emit = Callable[[str, dict], Awaitable[None]]
  ..streaming protocol — checked by nothing at runtime..
  emit("token" | "reasoning" | "status" | "step" | "research", dict)
  **emit("meta", dict) — exactly once, last**
}

