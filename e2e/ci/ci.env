# e2e/ci/ci.env — the NON-SECRET half of the hosted end-to-end stage's
# environment. e2e/ci/stack.sh reads this file and then adds the values that
# are generated fresh for each run (database URL, session signing key, API key
# pepper, the two account passwords). Nothing credential-shaped lives here,
# and nothing here is read from `inputs.` or `vars.`.
#
# WHY A CHECKED-IN FILE AND NOT `docker inspect` OF A RUNNING CONTAINER:
# scripts/e2e-stack.sh copies the production orchestrator's whole environment
# through a denylist, which means every credential production gains in future
# is copied by default. This stage starts from nothing and names what it
# needs. An allowlist fails closed; a denylist fails open.
#
# Format: KEY=value, one per line, `#` comments, no shell expansion, no
# quotes. stack.sh refuses any line that is not that shape.

# ---------------------------------------------------------------- the stack
# Container and network names. Every one carries `e2e-ci` so nothing here can
# name a production object even by accident.
STACK_PROJECT=techsara-e2e-ci
STACK_NETWORK=techsara-e2e-ci-net
STACK_ENGINE_NAME=techsara-e2e-ci-engine
STACK_ORCH_NAME=techsara-e2e-ci-orchestrator
STACK_FRONT_NAME=techsara-e2e-ci-frontend
# Published on 127.0.0.1 ONLY (stack.sh spells the address out in every -p).
# 3901 is inside the suite's default E2E_ALLOWED_PORTS (3900-3999), and it is
# not 3000/8080, which lib/config.js refuses on every host as production.
STACK_FRONT_PORT=3901
STACK_ORCH_PORT=8901
# The stub engine publishes NO host port: its peers reach it by container name
# on the private network. This is the port inside that network.
STACK_ENGINE_PORT=8000
# The database is the job's `services: postgres` container, reached from our
# own network through the docker host gateway.
STACK_PG_HOST=host.docker.internal
STACK_PG_PORT=5432
STACK_PG_USER=test
STACK_PG_DB=techsara_e2e_ci_test

# ------------------------------------------------- the engine contract
# Every model endpoint points at the in-repo stub (e2e/ci/engine.js). There is
# no path from a hosted runner to this deployment's engines that does not mean
# opening them, so CI never dials a real one. `--chat-mode live` is refused in
# this stage for the same reason.
OPENAI_BASE_URL=http://techsara-e2e-ci-engine:8000/v1
ROUTER_BASE_URL=http://techsara-e2e-ci-engine:8000/v1
AGENT_BASE_URL=http://techsara-e2e-ci-engine:8000/v1
VISION_BASE_URL=http://techsara-e2e-ci-engine:8000/v1
EMBED_BASE_URL=http://techsara-e2e-ci-engine:8000/v1
RERANK_BASE_URL=http://techsara-e2e-ci-engine:8000/v1
OCR_BASE_URL=http://techsara-e2e-ci-engine:8000/v1
# The key a local inference server wants is a placeholder, exactly as
# app/config.py:167 documents it. It is not a credential.
OPENAI_API_KEY=local
MAIN_MODEL=stub-main
LLM_MODEL=stub-main
ROUTER_MODEL=stub-router
AGENT_MODEL=stub-router
VISION_MODEL=stub-main
EMBED_MODEL=stub-embed
OCR_MODEL=stub-ocr
# REMOTE, never INPROCESS: the in-process path loads torch and a reranker
# model, which this image does not carry and a hosted runner cannot afford.
RERANK_BACKEND=remote
RERANK_MODEL=stub-rerank
# What the stub publishes on /v1/models, and the window it claims.
STUB_ENGINE_MODELS=stub-main,stub-router,stub-embed,stub-rerank,stub-ocr
STUB_ENGINE_MAX_MODEL_LEN=32768
STUB_ENGINE_EMBED_DIM=1024

# ------------------------------------------------------- capability flags
OCR_ENABLED=true
ASR_ENABLED=false
VIDEO_ANALYSIS_ENABLED=false
# No third-party search provider is configured in CI and none may be: a key
# would have to be a stored secret, and this stage deliberately holds none.
WEB_SEARCH_ENABLED=false
SF_LIVE_ENABLED=false

# ----------------------------------------------------------------- paths
WORKSPACE_DIR=/data/workspace
VIDEO_DATA_DIR=/data/video
LANCEDB_DIR=/data/lancedb
LANCEDB_WEB_DIR=/data/lancedb-web
LANCEDB_VIDEO_DIR=/data/lancedb-video
DUCKDB_PATH=/data/warehouse.duckdb
PARQUET_DIR=/data/parquet
REPORTS_DIR=/reports
MPLCONFIGDIR=/tmp/matplotlib
XDG_CACHE_HOME=/tmp/cache

# ------------------------------------------------- CAPACITY, and only capacity
# A hosted runner has ~14 GiB free; the product's defaults are 250 GiB for the
# Files store (PUBLIC_API_FILES_MIN_FREE_GIB, app/apifiles/limits.py:84) and
# 20 GiB for the public API's disk guard (PUBLIC_API_MIN_FREE_DISK_BYTES,
# app/resources.py:232). Unset, every upload check in the suite would be
# refused by a watermark that is about the DGX's 3.7 T filesystem and says
# nothing about this product's behaviour.
#
# THIS IS A CAPACITY RELAXATION, NOT A SECURITY ONE. No authentication, scope,
# rate limit, quota or lockout threshold is relaxed anywhere in this stage —
# in particular the per-address sign-in lockout keeps its real threshold, and
# the suite's one wrong-password check runs against it, because this stack is
# created and destroyed inside one job and nobody else signs in through it.
PUBLIC_API_FILES_MIN_FREE_GIB=1
PUBLIC_API_MIN_FREE_DISK_BYTES=1073741824

# ------------------------------------------------------------ the accounts
# Emails only. The PASSWORDS are generated per run with `openssl rand -hex 24`,
# written under $RUNNER_TEMP with mode 600 and passed to the suite through
# E2E_ADMIN_PASSWORD_FILE / E2E_MEMBER_PASSWORD_FILE, which
# e2e/platform/lib/config.js:183,187 already read. A throwaway stack does not
# need a durable credential, and a durable one on a public repository's hosted
# runners is a liability.
E2E_ADMIN_EMAIL=e2e-ci-admin@test.local
E2E_MEMBER_EMAIL=e2e-ci-member@test.local
