{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://techsara.local/schemas/salesforce-evaluation-result-v1.json",
  "title": "TechSara Salesforce Case Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "passed", "first_incorrect_stage", "checks"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "passed": {"type": "boolean"},
    "first_incorrect_stage": {"type": ["string", "null"]},
    "checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "status", "expected", "actual", "message"],
      "properties": {
        "stage": {"type": "string", "minLength": 1},
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "not_evaluable"]
        },
        "expected": {},
        "actual": {},
        "message": {"type": "string"}
      }
    }
  }
}
