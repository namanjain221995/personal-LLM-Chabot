# Env-file shape fixture for test_env_file_shapes.py.
# Every value is a placeholder; nothing here is a real credential.
# This file is deliberately byte-sensitive: it opens with a UTF-8 BOM and
# two lines near the end use CRLF. See .gitattributes.
BOM_FIRST_KEY=first
BARE_WITH_SPACE=two words
WITH_PARENS=node two (auto-detected)
HASH_INSIDE=value#tight
HASH_AFTER_SPACE=value # trailing comment
EMPTY_VALUE=
DQUOTED="two words"
SQUOTED='two words'
EQUALS_INSIDE=a=b=c
export EXPORTED_KEY=exported value
DQUOTED_THEN_COMMENT="quoted" # trailing comment
JSON_VALUE={"method":"mtp","num_speculative_tokens":1}
APOSTROPHE_INSIDE=it's quoted oddly
CRLF_ONE=crlf one
CRLF_TWO=crlf two
SENTINEL_LAST=reached-the-end
