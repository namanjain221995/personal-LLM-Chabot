  "panels": [
    {
      "type": "text",
      "title": "",
      "datasource": {
        "type": "prometheus",
        "uid": "dgx-prometheus"
      },
      "options": {
        "mode": "markdown",
        "content": "Every panel reads **InfiniBand and NIC counters**. RDMA traffic never touches the kernel network stack, so ordinary network counters read flat zero on a healthy fabric. Only `rocep1s0f1` and `roceP2p1s0f1` carry a link: the two PCIe rails of one 200 Gb/s QSFP port. A single rail tops out near 109 Gb/s by design, so there is no percent-of-capacity panel here.",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        }
      },
      "transparent": true,
      "id": 1,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "table",
      "title": "Ports",
      "datasource": {
        "type": "prometheus",
        "uid": "dgx-prometheus"
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Node",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "node",
                "device",
                "Value #A",
                "Value #B",
                "Value #C",
                "Value #D",
                "Value #E",
                "Value #F"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "node": 0,
              "device": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7
            },
            "renameByName": {
              "node": "Node",
              "device": "Port",
              "Value #A": "State",
              "Value #B": "Received",
              "Value #C": "Sent",
              "Value #D": "Retransmits/s",
              "Value #E": "Congestion/s",
              "Value #F": "Gave up 1h"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
