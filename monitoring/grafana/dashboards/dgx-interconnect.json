                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#f2495c",
                      "value": null
                    },
                    {
                      "color": "#76b900",
                      "value": 4
                    }
                  ]
                }
              },
              {
                "id": "mappings",
