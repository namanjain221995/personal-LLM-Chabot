      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dgx-prometheus"
          },
          "editorMode": "code",
          "expr": "max by (node, device) (node_infiniband_state_id{node=~\"$node\",device=~\"rocep1s0f1|roceP2p1s0f1\"})",
          "range": false,
          "instant": true,
          "legendFormat": "",
          "format": "table",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dgx-prometheus"
          },
          "editorMode": "code",
          "expr": "8 * max by (node, device) (rate(node_infiniband_port_data_received_bytes_total{node=~\"$node\",device=~\"rocep1s0f1|roceP2p1s0f1\"}[2m]))",
          "range": false,
          "instant": true,
          "legendFormat": "",
          "format": "table",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dgx-prometheus"
          },
          "editorMode": "code",
          "expr": "8 * max by (node, device) (rate(node_infiniband_port_data_transmitted_bytes_total{node=~\"$node\",device=~\"rocep1s0f1|roceP2p1s0f1\"}[2m]))",
          "range": false,
          "instant": true,
          "legendFormat": "",
          "format": "table",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dgx-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (node, device) (rate(spark_roce_hw_counter_total{node=~\"$node\",counter=~\"roce_adp_retrans|local_ack_timeout_err|out_of_sequence|packet_seq_err|implied_nak_seq_err|rnr_nak_retry_err\"}[5m]))",
          "range": false,
          "instant": true,
          "legendFormat": "",
          "format": "table",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dgx-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (node, device) (rate(spark_roce_hw_counter_total{node=~\"$node\",counter=~\"np_cnp_sent|rp_cnp_handled\"}[5m]))",
          "range": false,
          "instant": true,
          "legendFormat": "",
          "format": "table",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dgx-prometheus"
          },
          "editorMode": "code",
          "expr": "max by (node, device) (increase(spark_roce_hw_counter_total{node=~\"$node\",counter=~\"req_transport_retries_exceeded|req_rnr_retries_exceeded\"}[1h]))",
          "range": false,
          "instant": true,
