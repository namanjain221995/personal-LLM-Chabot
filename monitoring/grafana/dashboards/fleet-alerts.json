    {
      "type": "table",
      "title": "Firing",
      "datasource": {
        "type": "prometheus",
        "uid": "dgx-prometheus"
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Since",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "severity",
                "alertname",
                "node",
                "container",
                "device",
                "service",
                "kind",
                "mountpoint",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "severity": 0,
              "alertname": 1,
              "node": 2,
              "container": 3,
              "device": 4,
              "service": 5,
              "kind": 6,
              "mountpoint": 7,
              "Value": 8
            },
            "renameByName": {
              "severity": "Severity",
              "alertname": "Alert",
              "node": "Node",
              "container": "Container",
              "device": "Device",
              "service": "Service",
              "kind": "Kind",
              "mountpoint": "Mount",
              "Value": "Since"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d8d9da",
                "value": null
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Since"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "text": "critical",
                        "color": "#f2495c",
                        "index": 0
                      },
                      "warning": {
                        "text": "warning",
                        "color": "#fab219",
                        "index": 1
                      },
                      "info": {
                        "text": "info",
                        "color": "#5794f2",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
      "description": "Nothing is sent anywhere, by the owner's decision: this page and Prometheus' /alerts are where alerts live. Empty means nothing is firing.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dgx-prometheus"
          },
          "editorMode": "code",
          "expr": "max by (alertname, severity, node, container, device, service, kind, mountpoint) (ALERTS_FOR_STATE and ignoring (alertstate) ALERTS{alertstate=\"firing\"}) * 1000",
          "range": false,
          "instant": true,
          "legendFormat": "",
          "format": "table",
          "refId": "A"
        }
      ],
      "id": 10,
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 4
      }
    },
