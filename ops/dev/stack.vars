# Values that make the repository's compose files render a separate dev stack
# instead of production (compose.yaml header). Pass with --env-file together
# with the dev stack's own generated env, on the worker's Docker daemon. Not
# secrets; never production values; no host names or addresses (the engine
# addresses live only in the gitignored ops/dev/.runtime/engines.env).
#
# Used as the FIRST --env-file of ops/dev/devstack.sh's one compose command
# line (README.md). ops/dev/compose.dev.yaml repeats, as literals, the values
# that must hold even if a caller's shell exports a different one (a shell
# variable outranks --env-file in Compose interpolation): names, loopback
# binds and the outside-service switches. devstack.sh also refuses to run
# when the shell sets TECHSARA_STACK or any of the env-file paths below.

# Project, image and volume prefix. Production never sets it (sf-local-ai).
TECHSARA_STACK=llmdev

# Published ports bind the worker's loopback only; reach them through an SSH
# port forward. Not production's 8080/3000, and free on the worker.
TECHSARA_BIND_ADDRESS=127.0.0.1
ORCHESTRATOR_PORT=28080
FRONTEND_PORT=23000

# The dev stack's own env files, relative to the worktree root. All three are
# gitignored and written by ops/dev/init-env.sh (which reads these three
# lines to know where), never by hand:
#   TECHSARA_SECRET_ENV       synthetic secrets: database password, session
#                             secret, API-key pepper; random per worktree, 0600
#   TECHSARA_GENERATED_ENV    the generated engine and feature settings; every
#                             engine URL points at the inference-cap service
#   TECHSARA_DEV_ENGINES_ENV  the inference cap's upstream addresses, the only
#                             file that names the head's engines
TECHSARA_SECRET_ENV=ops/dev/.env
TECHSARA_GENERATED_ENV=ops/dev/.runtime/orchestrator.env
TECHSARA_DEV_ENGINES_ENV=ops/dev/.runtime/engines.env

# Live Salesforce reads: off. Production's compose default is true.
SF_LIVE_ENABLED=false
# Salesforce credentials: blank, so nothing in the dev stack can log in to the
# production org. compose.yaml interpolates these into the orchestrator and
# the sync-worker; the sync-worker is not started at all.
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_LOGIN_URL=
SF_PRIVATE_KEY_B64=

# Paid web-search providers: blank. Search is off in the dev stack.
TAVILY_API_KEY=
BRAVE_API_KEY=

# Speech to text, the voice archive and video analysis use engines and a
# store on the worker that belong to production: all off, no addresses.
ASR_ENABLED=false
ASR_BASE_URL=
ASR_BASE_URLS=
VOICE_ARCHIVE_ENABLED=false
VOICE_ARCHIVE_URL=
VOICE_ARCHIVE_TLS_CERT_B64=
VIDEO_ANALYSIS_ENABLED=false

# Production's remote OCR engine: never. OCR is off (init-env.sh).
OCR_REMOTE_BASE_URL=

# The /v1 relay through the v1-gateway: off. The gateway is not started.
V1_GATEWAY_URL=
PUBLIC_API_GATEWAY_PEERS=
PUBLIC_API_TRUSTED_PROXIES=
