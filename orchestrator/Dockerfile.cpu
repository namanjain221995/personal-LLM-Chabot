# syntax=docker/dockerfile:1
# Multi-architecture application image for CPU, macOS-hosted inference, and
# external OpenAI-compatible endpoints. It intentionally contains no CUDA or
# torch runtime; CPU profiles disable or remotely serve reranking.
# BUMPED 2026-09-23. The previous pin,
#   sha256:90744cff8f32887f075c47d747a173ff333e9e98801667af93c357fa9f5e28ff
# carried CVE-2026-13221 (perl: incorrect regular expression processing) and
# CVE-2026-42496 (perl-archive-tar: path traversal) -- both CRITICAL, both with
# a fixed version available, so the blocking image pass
#   trivy image --scanners vuln --severity CRITICAL --ignore-unfixed --exit-code 1
# exits 1 on it. This digest is the SAME python:3.11-slim tag (3.11.16-slim-trixie),
# rebuilt 2026-09-19, and scans clean under that policy. It is the multi-arch INDEX
# digest, so it resolves on CI's amd64 and on the box's arm64 alike.
FROM python:3.11-slim@sha256:da047cb8f9d1d98e5c070f5300ba9f7274e33b8fc0e5be5ed88740aed1b95ba9

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# git powers repository analysis. pandoc + WeasyPrint's native libraries power
# DOCX/PDF reports. curl is used by the container readiness probe.
# Fonts, all open-licence. The renderers map a requested proprietary name to
# one of these (app/artifacts/style.py FONT_ALLOWLIST, render/theme.resolve_font):
#   fonts-liberation(2)          metric twins of Arial/Helvetica, Times New
#                                Roman, Courier New (liberation2 is transitional
#                                on noble/trixie; kept for older bases)
#   fonts-crosextra-carlito      metric twin of Calibri
#   fonts-crosextra-caladea      metric twin of Cambria; Georgia's documented
#                                fallback (Gelasio, Georgia's twin, is packaged
#                                for neither Ubuntu noble nor Debian trixie)
#   fonts-dejavu-core            Verdana/Tahoma-class sans, generic last resort
#   fonts-noto-core, fonts-lohit-deva, fonts-lohit-gujr
#                                Devanagari and Gujarati for PDFs and chart labels
# Names verified with apt-get install --simulate on this base (2026-09-15).
# tests/test_artifact_fonts.py asserts fc-match resolves them.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        pandoc \
        ffmpeg \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        libpangocairo-1.0-0 \
        libcairo2 \
        libgdk-pixbuf-2.0-0 \
        libharfbuzz0b \
        libffi8 \
        shared-mime-info \
        fonts-dejavu-core \
        fonts-liberation \
        fonts-liberation2 \
        fonts-crosextra-carlito \
        fonts-crosextra-caladea \
        fonts-noto-core \
        fonts-lohit-deva \
        fonts-lohit-gujr \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app

ENV REPORTS_DIR=/reports \
    DUCKDB_PATH=/data/warehouse.duckdb \
    LANCEDB_DIR=/data/lancedb \
    PARQUET_DIR=/data/parquet

# The launcher starts this container before the non-root sync worker. Seed the
# empty named volume with directories writable by the worker's stable UID so a
# clean first run cannot turn the shared warehouse paths into root-only data.
RUN mkdir -p /reports /data/parquet /data/lancedb /tmp/matplotlib /tmp/cache \
    && chown -R 10001:10001 /data

EXPOSE 8080
# --timeout-graceful-shutdown: how long uvicorn waits for in-flight
# responses after SIGTERM before it force-closes them and runs the lifespan
# shutdown hook. WITHOUT IT uvicorn waits forever, and an SSE stream may
# legitimately run GEN_WALL_CLOCK_S (4,200 s in production) — so compose's
# `stop_grace_period: 2m` expired first and SIGKILL landed before the hook
# ever ran (INF-3). That hook is what marks open chat requests `interrupted`
# and releases the video leases, so losing it is what left a restarted
# generation with nothing to resume from.
#
# 90 s of the 120 s grace, leaving 30 s for the hook itself — whose own work
# is bounded well inside that (video pipeline.stop() waits at most 5 s for
# its runs, web_worker.stop() awaits one cancelled task, the pool close and
# the interrupt UPDATE are single statements).
#
# What it means for a stream older than 90 s: it is cut. That is the
# designed path, not a loss — the request row is marked `interrupted` by the
# hook that now always runs, and the browser re-attaches through
# GET /chat/requests/{intent_id} and GET /chat/attach/{conversation_id}
# (docs/upload-reliability/API.md). A chunked part PUT cut the same way
# leaves no accepted part and the client re-sends that one part.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", \
     "--timeout-graceful-shutdown", "90"]
