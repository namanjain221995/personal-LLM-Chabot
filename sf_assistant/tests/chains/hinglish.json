  {
   "id": "H03",
   "title": "top 2 dikhao on a Hinglish candidates count keeps the Person Account scope",
   "design": "design v2 §6.2 ranking shortcuts in Hinglish, §7.1 terms carried (candidates), §16.1 H03",
   "steps": [
    {
     "q": "status wise kitne candidates hain",
     "record": [
      {
       "name": "group_records",
       "args": {
        "object": "Account",
        "group_by": "Candidate_Status__c"
       }
      },
      "The candidates by status are shown.\nSource: the synthetic warehouse copy."
     ],
     "expect": {
      "reason": "new",
      "contracts": [
       "candidates"
      ],
      "ran": [
       {
        "tool": "group_records",
        "args": {
         "object": "Account",
         "group_by": "Candidate_Status__c"
        },
        "term_filters": [
         "RecordTypeId = 'Person Account'"
        ],
        "enforced_has": {
         "filters": [
          {
           "field": "RecordTypeId",
           "op": "eq",
           "value": "PersonAccount"
          }
         ]
        },
        "result_has": {
         "groups": [
          {
           "group": "(blank)",
           "value": 2
          },
          {
           "group": "Placed",
           "value": 2
          },
          {
           "group": "Active",
           "value": 1
          }
         ]
        }
       }
      ],
      "plan": {
       "calls": [
        {
         "tool": "group_records",
         "args": {
          "object": "Account",
          "group_by": "Candidate_Status__c"
         }
        }
       ],
       "keys": [
        "candidates"
       ]
      }
     }
    },
    {
     "q": "top 2 dikhao",
     "record": [
      "The top 2 are shown.\nSource: the synthetic warehouse copy."
     ],
     "expect": {
      "reason": "shortcut",
      "model": false,
      "contracts": [
       "candidates"
      ],
      "ran": [
       {
        "tool": "group_records",
        "args": {
         "object": "Account",
         "group_by": "Candidate_Status__c",
         "top": 2,
         "order": "desc"
        },
        "term_filters": [
         "RecordTypeId = 'Person Account'"
        ]
       }
      ],
      "plan_line_has": [
       "top 2",
       "candidates as Person Accounts"
      ]
     }
    }
   ]
  },
