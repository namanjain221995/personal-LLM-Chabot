   "steps": [
    {
     "q": "how many interviews per recruiter this year",
     "record": [
      {
       "name": "group_records",
       "args": {
        "object": "Interview__c",
        "group_by": "Recruiter__c",
        "date_field": "Date_of_Interview__c",
        "period": "this year"
       }
      },
      "The interviews per recruiter are shown.\nSource: the synthetic warehouse copy."
     ],
     "expect": {
      "status": "answered",
      "reason": "new",
      "model": false,
      "ran": [
       {
        "tool": "group_records",
        "args": {
         "object": "Interview__c",
         "group_by": "Recruiter__c",
         "date_field": "Date_of_Interview__c",
         "period": "this year"
        }
       }
      ],
      "plan": {
       "calls": [
        {
         "tool": "group_records",
         "args": {
          "object": "Interview__c",
          "group_by": "Recruiter__c",
          "date_field": "Date_of_Interview__c",
          "period": "this year"
