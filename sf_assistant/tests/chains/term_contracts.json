{
 "title": "Patches that meet the business-term contracts (design v2 §16.1 T01-T05)",
 "chains": [
  {
   "id": "T01",
   "title": "A patch that would count candidates from Lead records is refused (T1) and asks; the plan stays",
   "design": "design v2 §6.4 checks on every patched plan (term plan, T1 becomes a clarify), §16.1 T01",
   "steps": [
    {
     "q": "how many candidates had interviews this year, by interview status",
     "record": [
      {
       "name": "group_records",
       "args": {
        "object": "Interview__c",
        "group_by": "Interview_Status__c",
        "measure": "count_distinct",
        "measure_field": "Candidate__c",
        "date_field": "Date_of_Interview__c",
        "period": "this year"
       }
      },
      "Shown.\nSource: the synthetic warehouse copy."
     ],
     "expect": {
      "reason": "new",
      "contracts": [
       "candidates"
      ],
      "ran": [
       {
        "tool": "group_records",
        "args": {
         "object": "Interview__c",
         "group_by": "Interview_Status__c",
         "measure": "count_distinct",
         "measure_field": "Candidate__c",
         "date_field": "Date_of_Interview__c",
         "period": "this year"
        },
        "term_filters": [
         "Candidate__c.RecordTypeId = 'Person Account'"
        ]
       }
      ],
      "plan": {
       "keys": [
        "candidates"
       ]
      }
     }
    },
    {
     "q": "group them by Lead__c instead",
     "resolve": {
      "kind": "patch",
      "standalone": "",
      "ops": [
       {
        "set_group": {
         "field": "Lead__c"
        }
       }
      ]
     },
     "expect": {
      "status": "answered",
      "kind": "none",
      "reason": "clarify",
      "model": true,
      "record": false,
      "ran_none": true,
      "detail": "check_term_reject",
      "answer": "That change would count candidates from records that are not candidates (candidates are Person Accounts). Please ask the full question.",
      "pending": null,
      "plan": {
       "calls": [
        {
         "tool": "group_records",
         "args": {
          "object": "Interview__c",
          "group_by": "Interview_Status__c",
          "measure": "count_distinct",
          "measure_field": "Candidate__c",
          "date_field": "Date_of_Interview__c",
          "period": "this year"
         }
        }
       ],
       "keys": [
        "candidates"
       ],
       "age": 0
      }
     }
    },
    {
     "q": "visualize it",
     "record": [
      "The chart is drawn.\nSource: the synthetic warehouse copy."
     ],
     "expect": {
      "reason": "shortcut",
      "model": false,
      "contracts": [
       "candidates"
      ],
      "ran": [
       {
        "tool": "group_records",
        "args": {
         "object": "Interview__c",
         "group_by": "Interview_Status__c",
         "measure": "count_distinct",
         "measure_field": "Candidate__c",
         "date_field": "Date_of_Interview__c",
         "period": "this year"
        },
        "term_filters": [
         "Candidate__c.RecordTypeId = 'Person Account'"
        ]
       }
      ],
      "plan": {
       "show_chart": true
      }
     }
    }
   ]
